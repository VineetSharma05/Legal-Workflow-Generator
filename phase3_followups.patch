+"""Run settings: validation, config parsing and contextvar propagation (no network)."""
+import pytest
+
+from legal_workflow_generator.agent.settings import (
+    RunSettings, build_config, current_settings, use_settings,
+)
+
+
+def test_defaults_and_overrides():
+    s = RunSettings.from_config(build_config(provider="Gemini", top_k="5", as_of="2025-04-01", verify_claims="false"))
+    assert (s.provider, s.top_k, s.verify_claims) == ("gemini", 5, False)
+    assert str(s.as_of_date) == "2025-04-01"
+
+
+@pytest.mark.parametrize("bad", [{"top_k": 0}, {"top_k": 21}, {"provider": "openai"}, {"as_of": "01-04-2025"},
+                                 {"max_domain_retries": 9}])
+def test_invalid_values_raise(bad):
+    with pytest.raises(ValueError):
+        RunSettings.from_config(build_config(**bad))
+
+
+def test_none_values_fall_back_to_defaults():
+    assert RunSettings.from_config(build_config(top_k=None, provider=None)).top_k == 8
+
+
+def test_langgraph_keys_are_ignored():
+    assert RunSettings.from_config({"configurable": {"thread_id": "x", "top_k": 3}}).top_k == 3
+
+
+def test_settings_reach_worker_threads():
+    from concurrent.futures import ThreadPoolExecutor
+    from legal_workflow_generator.agent.nodes import _submit
+    use_settings(build_config(top_k=4))
+    with ThreadPoolExecutor(max_workers=2) as ex:
+        assert _submit(ex, lambda: current_settings().top_k).result() == 4