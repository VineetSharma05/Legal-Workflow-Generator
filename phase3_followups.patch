+"""Aggregate completed expert rating sheets: means, reliance rate, critical-error rate, inter-rater agreement.
+
+    python evals/expert/aggregate_expert.py evals/expert/sheets/expert_*.csv
+"""
+import csv
+import statistics as st
+import sys
+from collections import defaultdict
+from itertools import combinations
+
+DIMS = ["correctness_1to5", "legal_accuracy_1to5", "completeness_1to5", "usefulness_1to5"]
+
+
+def load(path):
+    return {r["case_id"]: r for r in csv.DictReader(open(path, encoding="utf-8")) if r["correctness_1to5"].strip()}
+
+
+def qwk(a, b, lo=1, hi=5):
+    """Quadratic weighted kappa between two raters over the same cases."""
+    n = hi - lo + 1
+    obs = [[0] * n for _ in range(n)]
+    for x, y in zip(a, b):
+        obs[x - lo][y - lo] += 1
+    ha = [sum(r) for r in obs]; hb = [sum(obs[i][j] for i in range(n)) for j in range(n)]
+    tot = len(a)
+    num = den = 0.0
+    for i in range(n):
+        for j in range(n):
+            w = (i - j) ** 2 / (n - 1) ** 2
+            num += w * obs[i][j]; den += w * ha[i] * hb[j] / tot
+    return 1 - num / den if den else float("nan")
+
+
+def main(paths):
+    sheets = [load(p) for p in paths]
+    print(f"{len(sheets)} raters, cases rated: {[len(s) for s in sheets]}")
+    for d in DIMS:
+        vals = [int(r[d]) for s in sheets for r in s.values() if r[d].strip()]
+        print(f"{d:24s} mean={st.mean(vals):.2f}  sd={st.pstdev(vals):.2f}  n={len(vals)}")
+    rows = [r for s in sheets for r in s.values()]
+    yn = lambda k: sum(r[k].strip().lower().startswith("y") for r in rows) / len(rows)
+    print(f"would_rely               {yn('would_rely_yn'):.0%}")
+    print(f"critical_error           {yn('critical_error_yn'):.0%}")
+    ans = [r for r in rows if str(r["abstained"]).lower() != "true"]
+    if ans:
+        print(f"usefulness (answered only) mean={st.mean(int(r['usefulness_1to5']) for r in ans):.2f}")
+    for (i, a), (j, b) in combinations(enumerate(sheets, 1), 2):
+        common = sorted(set(a) & set(b))
+        if len(common) < 2:
+            print(f"QWK expert{i}-expert{j}: skipped (fewer than 2 shared rated cases)"); continue
+        for d in DIMS:
+            k = qwk([int(a[c][d]) for c in common], [int(b[c][d]) for c in common])
+            print(f"QWK expert{i}-expert{j} {d:22s} {k:.2f}  (n={len(common)})")
+
+
+if __name__ == "__main__":
+    main(sys.argv[1:] or sys.exit(__doc__))
