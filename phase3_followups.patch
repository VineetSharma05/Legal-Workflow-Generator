+"""Browser-level tests for the frontend workflow inspector.
+
+They serve the real static frontend and mock /api/* with Playwright, so no database, corpus or LLM key is needed.
+
+    uv add --dev pytest-playwright && uv run playwright install chromium
+    uv run pytest -m e2e tests/e2e
+"""
+import functools
+import http.server
+import threading
+from pathlib import Path
+
+import pytest
+
+pytest.importorskip("playwright", reason="pip install pytest-playwright && playwright install chromium")
+
+STATIC = Path(__file__).resolve().parents[2] / "legal_workflow_generator" / "presentation" / "static"
+
+
+@pytest.fixture(scope="session")
+def frontend_url():
+    handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory=str(STATIC))
+    handler.log_message = lambda *a, **k: None
+    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), handler)
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    yield f"http://127.0.0.1:{server.server_address[1]}/index.html"
+    server.shutdown()
+
+
+def chat_payload(**over):
+    payload = {
+        "answer": "LEGAL COMPLIANCE WORKFLOW\nStep 1: Obtain consent — [dpdp_act_2023_sec_6]",
+        "abstained": False,
+        "settings": {"provider": "gemini", "top_k": 8, "as_of": "2026-10-13", "verify_claims": True},
+        "pipeline": {
+            "classification": {"intent": "workflow", "domain": "data_protection", "all_domains": ["data_protection"],
+                               "normalized_query": "consent", "keywords": ["consent"], "confidence": 0.9},
+            "retrieval": {"docs": [{"provision_id": "dpdp_act_2023_sec_6", "title": "Consent", "text": "t",
+                                    "combined_score": 0.9, "bm25_score": 0.8, "semantic_score": 0.9}],
+                          "rewritten_query": None, "retry_count": 0},
+            "context_grading": {"grade": "sufficient", "reason": "ok"},
+            "generation": {"citations": ["dpdp_act_2023_sec_6"], "retry_count": 0},
+            "citation_verification": {"verified": ["dpdp_act_2023_sec_6"], "failed": []},
+            "claim_verification": {
+                "entailed": 1, "partial": 1, "unchecked": 0, "dropped": 1,
+                "steps": [{"domain": "data_protection", "action": "a", "provision_id": "dpdp_act_2023_sec_6",
+                           "verdict": "partial", "verdict_reason": "adds detail", "note": ""}],
+                "dropped_steps": [{"domain": "data_protection", "action": "c",
+                                   "provision_id": "dpdp_act_2023_sec_9", "verdict_reason": "not in text"}]},
+            "groundedness": {"grade": "grounded", "reason": "ok"},
+            "answerability": {"grade": "answers", "reason": "ok"},
+            "abstain_info": {"triggered": False, "reason": ""},
+        },
+        "trace": ["classify → ok", "grade_groundedness → grounded"],
+    }
+    payload.update(over)
+    return payload
