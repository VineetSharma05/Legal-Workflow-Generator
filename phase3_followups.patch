@@ -0,0 +1,49 @@
+"""Build blinded rating sheets for legal experts from an eval_agent.py results JSON.
+
+    python evals/expert/make_rating_sheet.py evals/results/eval_results_XXXX.json --experts 3 --sample 30 --seed 7
+
+Writes one CSV per expert (same cases, independently shuffled order, no system metrics visible) plus a key file
+mapping case_id -> query. Abstained / errored runs are included so experts also judge whether abstaining was right.
+"""
+import argparse
+import csv
+import json
+import random
+from pathlib import Path
+
+FIELDS = ["case_id", "query", "system_answer", "abstained",
+          "correctness_1to5", "legal_accuracy_1to5", "completeness_1to5", "usefulness_1to5",
+          "critical_error_yn", "would_rely_yn", "comments"]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("results_json")
+    ap.add_argument("--experts", type=int, default=3)
+    ap.add_argument("--sample", type=int, default=30)
+    ap.add_argument("--seed", type=int, default=7)
+    ap.add_argument("--out", default="evals/expert/sheets")
+    a = ap.parse_args()
+
+    rows = [r for r in json.load(open(a.results_json))["results"] if "error" not in r]
+    rng = random.Random(a.seed)
+    cases = rng.sample(rows, min(a.sample, len(rows)))
+    out = Path(a.out); out.mkdir(parents=True, exist_ok=True)
+
+    with open(out / "case_key.csv", "w", newline="", encoding="utf-8") as f:
+        w = csv.writer(f); w.writerow(["case_id", "query", "expected_domain", "abstained"])
+        for i, c in enumerate(cases, 1):
+            w.writerow([f"C{i:03d}", c["query"], c.get("expected_domain", ""), c.get("abstained")])
+
+    for e in range(1, a.experts + 1):
+        order = list(enumerate(cases, 1)); random.Random(a.seed + e).shuffle(order)
+        with open(out / f"expert_{e}.csv", "w", newline="", encoding="utf-8") as f:
+            w = csv.DictWriter(f, fieldnames=FIELDS); w.writeheader()
+            for i, c in order:
+                w.writerow({"case_id": f"C{i:03d}", "query": c["query"], "system_answer": c.get("answer", ""),
+                            "abstained": c.get("abstained")})
+    print(f"{len(cases)} cases -> {out}/expert_1..{a.experts}.csv")
+
+
+if __name__ == "__main__":
+    main()
