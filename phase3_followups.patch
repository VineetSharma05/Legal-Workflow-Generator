@@ -0,0 +1,62 @@
+import json
+
+import pytest
+from playwright.sync_api import Page, expect
+
+from .conftest import chat_payload
+
+pytestmark = pytest.mark.e2e
+
+
+def _ask(page: Page, url: str, body=None, status=200):
+    sent = {}
+
+    def handle(route):
+        sent.update(json.loads(route.request.post_data))
+        route.fulfill(status=status, content_type="application/json", body=json.dumps(body or chat_payload()))
+
+    page.route("**/api/chat", handle)
+    page.goto(url)
+    page.fill("#chat-input", "How do I comply with DPDP?")
+    page.click("#send-btn")
+    return sent
+
+
+def test_request_carries_provider_top_k_and_as_of(page: Page, frontend_url):
+    sent = {}
+    page.route("**/api/chat", lambda r: (sent.update(json.loads(r.request.post_data)),
+                                         r.fulfill(content_type="application/json", body=json.dumps(chat_payload()))))
+    page.goto(frontend_url)
+    page.select_option("#provider-select", "groq")
+    page.fill("#asof-input", "2025-06-01")
+    page.eval_on_selector("#topk-slider", "e => { e.value = 12; e.dispatchEvent(new Event('input')); }")
+    page.fill("#chat-input", "q")
+    page.click("#send-btn")
+    expect(page.locator(".pipeline-toggle")).to_be_visible()
+    assert (sent["provider"], sent["top_k"], sent["as_of"]) == ("groq", 12, "2025-06-01")
+
+
+def test_inspector_shows_stages_and_claim_verdicts(page: Page, frontend_url):
+    _ask(page, frontend_url)
+    page.locator(".pipeline-toggle").click()
+    expect(page.locator(".pipeline-content.open")).to_be_visible()
+    names = page.locator(".stage-name").all_inner_texts()
+    for stage in ("Classification", "Citation Verification", "Claim Verification", "Groundedness", "Answerability"):
+        assert stage in names
+    claim = page.locator(".stage", has_text="Claim Verification")
+    expect(claim.locator(".stage-summary")).to_have_text("1 entailed, 1 partial, 1 dropped")
+    claim.locator(".stage-header").click()
+    expect(claim).to_contain_text("dropped · dpdp_act_2023_sec_9")
+
+
+def test_abstained_answer_is_rendered(page: Page, frontend_url):
+    body = chat_payload(answer="I was unable to provide a reliable answer", abstained=True)
+    _ask(page, frontend_url, body)
+    expect(page.locator("#chat-messages")).to_contain_text("unable to provide a reliable answer")
+
+
+def test_http_error_shows_message_and_ui_recovers(page: Page, frontend_url):
+    _ask(page, frontend_url, {"detail": "Invalid option: top_k must be between 1 and 20"}, status=422)
+    expect(page.locator("#chat-messages")).to_contain_text("top_k must be between 1 and 20")
+    page.fill("#chat-input", "again")
+    expect(page.locator("#send-btn")).to_be_enabled()
