@@ -0,0 +1,125 @@
+"""Offline tests for entailment verification, rate limiting, deterministic traces and temporal filtering.
+Every LLM / DB / search boundary is replaced by a fake."""
+import datetime
+import json
+import threading
+import time
+
+import pytest
+
+from legal_workflow_generator.agent import nodes
+from legal_workflow_generator.agent.settings import build_config, use_settings
+
+D = datetime.date
+
+
+def _docs():
+    return [{"provision_id": "p1", "title": "T1", "text": "x", "full_text": "Employers must pay gratuity after five years."},
+            {"provision_id": "p2", "title": "T2", "text": "y", "full_text": "A company must keep a registered office."}]
+
+
+# ── claim-to-citation entailment ─────────────────────────────────────────────
+def _steps():
+    return [nodes.Step("Pay gratuity after 5 years", "p1"), nodes.Step("Pay gratuity after 1 year", "p1"),
+            nodes.Step("Keep a registered office and file annual returns", "p2")]
+
+
+def test_verify_claims_drops_unsupported_and_flags_partial(monkeypatch):
+    verdicts = {"verdicts": [{"n": 1, "verdict": "entailed", "reason": "ok"},
+                             {"n": 2, "verdict": "unsupported", "reason": "text says five years"},
+                             {"n": 3, "verdict": "partial", "reason": "no returns mentioned"}]}
+    monkeypatch.setattr(nodes, "_llm", lambda *a, **k: json.dumps(verdicts))
+    kept, dropped, msg = nodes._verify_claims("employment", _steps(), _docs())
+    assert [s.verdict for s in kept] == ["entailed", "partial"]
+    assert [s.action for s in dropped] == ["Pay gratuity after 1 year"]
+    assert "1 dropped" in msg
+
+
+def test_verify_claims_fails_open_when_llm_unavailable(monkeypatch):
+    def boom(*a, **k): raise nodes.LLMUnavailable("quota")
+    monkeypatch.setattr(nodes, "_llm", boom)
+    kept, dropped, msg = nodes._verify_claims("employment", _steps(), _docs())
+    assert len(kept) == 3 and dropped == [] and all(s.verdict == "unchecked" for s in kept)
+
+
+def test_verify_claims_fails_open_on_garbage(monkeypatch):
+    monkeypatch.setattr(nodes, "_llm", lambda *a, **k: "not json")
+    kept, dropped, _ = nodes._verify_claims("employment", _steps(), _docs())
+    assert len(kept) == 3 and dropped == []
+
+
+def test_invented_provision_ids_are_rejected():
+    ids = {"p1": "p1"}
+    assert nodes.Step.from_llm({"action": "a", "provision_id": "zzz"}, ids) is None
+    assert nodes.Step.from_llm({"action": "a", "provision_id": "P1", "applies_to": "weird"}, ids).applies_to == "unspecified"
+
+
+# ── rate limiter ─────────────────────────────────────────────────────────────
+def test_rate_limiter_enforces_window():
+    rl = nodes.RateLimiter(rpm=3, max_parallel=3, window=0.4)
+    t0 = time.monotonic()
+    for _ in range(4):
+        rl.acquire()
+    assert time.monotonic() - t0 >= 0.35          # 4th call had to wait for the window
+
+
+def test_rate_limiter_caps_parallel_calls():
+    rl = nodes.RateLimiter(rpm=1000, max_parallel=2)
+    live, peak, lock = 0, 0, threading.Lock()
+
+    def work():
+        nonlocal live, peak
+        with rl.slot():
+            with lock:
+                live += 1; peak = max(peak, live)
+            time.sleep(0.05)
+            with lock:
+                live -= 1
+    ts = [threading.Thread(target=work) for _ in range(8)]
+    [t.start() for t in ts]; [t.join() for t in ts]
+    assert peak <= 2
+
+
+def test_llm_retries_then_reports_unavailable(monkeypatch):
+    use_settings(build_config(provider="gemini"))
+    monkeypatch.setattr(time, "sleep", lambda *_: None)
+    monkeypatch.setitem(nodes._PROVIDERS, "gemini", lambda s, u: (_ for _ in ()).throw(Exception("429 RESOURCE_EXHAUSTED")))
+    with pytest.raises(nodes.LLMUnavailable):
+        nodes._llm("s", "u", max_retries=2)
+
+
+# ── deterministic trace ──────────────────────────────────────────────────────
+def test_grade_parallel_trace_order_is_fixed(monkeypatch):
+    use_settings(build_config(provider="gemini"))
+    def slow_or_fast(*a, **k):
+        time.sleep(0.05 * (hash(threading.current_thread().name) % 3)); return '{"grade":"grounded","reason":"r"}'
+    monkeypatch.setattr(nodes, "_llm", slow_or_fast)
+    monkeypatch.setattr(nodes, "_domain_of", lambda pid: "taxation")
+    base = {"answer": "a", "retrieved_docs": _docs(), "all_domains": ["taxation"], "domain": "taxation",
+            "verified_citations": ["p1"]}
+    traces = []
+    for _ in range(5):
+        st = {**base, "trace": []}
+        nodes.grade_parallel(st)
+        traces.append(tuple(st["trace"]))
+    assert len(set(traces)) == 1
+    assert traces[0][0].startswith("grade_groundedness") and traces[0][1].startswith("grade_answerability")
+
+
+def test_trace_timing_can_be_disabled():
+    use_settings(build_config(trace_timing=False))
+    assert nodes._el(time.perf_counter()) == ""
+
+
+# ── temporal awareness ───────────────────────────────────────────────────────
+def test_not_yet_in_force_provisions_are_excluded():
+    assert nodes._in_force({"effective_date": D(2024, 1, 1)}, D(2025, 1, 1))
+    assert not nodes._in_force({"effective_date": D(2026, 4, 1)}, D(2025, 1, 1))
+    assert nodes._in_force({"effective_date": None}, D(2025, 1, 1))          # unknown date is kept
+
+
+def test_superseded_statute_is_flagged_only_after_cutover():
+    pid = "income_tax_act_1961_sec_195"
+    assert nodes._temporal_note(pid, D(2026, 3, 31)) == ""
+    assert "Income-tax Act, 2025" in nodes._temporal_note(pid, D(2026, 10, 13))
+    assert nodes._temporal_note("dpdp_act_2023_sec_6", D(2026, 10, 13)) == ""
