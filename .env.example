# Required — the app refuses to start if any of these is missing or empty.
PGPASSWORD=
GEMINI_API_KEY=

# Optional — only needed when running the RAG pipeline with --provider groq.
GROQ_API_KEY=

# Optional — override the defaults shown here if your Postgres runs elsewhere.
# PGDATABASE=legal_workflow_generator
# PGUSER=postgres
# PGHOST=127.0.0.1
# PGPORT=5432
# GEMINI_MODEL=models/gemini-3.1-flash-lite
# GROQ_MODEL=llama-3.3-70b-versatile
